root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
max_line_length = 100
quote_style = single

[hyprland.lua]
# Noctalia's template hook checks for a double-quoted require("noctalia").
quote_style = double

[*.md]
trim_trailing_whitespace = false
